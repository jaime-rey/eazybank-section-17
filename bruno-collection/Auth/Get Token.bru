meta {
  name: Get Token
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  scope: {{scope}}
}

script:post-response {
  if (res.status === 200 && res.body && res.body.access_token) {
    bru.setVar("token", res.body.access_token);
    bru.setEnvVar("token", res.body.access_token);
    console.log("Token guardado (len=" + res.body.access_token.length + ")");
  } else {
    console.log("Fallo al obtener token: " + res.status);
  }
}

tests {
  test("obtiene access_token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
  });
}
