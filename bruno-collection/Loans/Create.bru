meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{gatewayUrl}}/eazybank/loans/api/create?mobileNumber={{mobileNumber}}
  body: none
  auth: bearer
}

params:query {
  mobileNumber: {{mobileNumber}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Requiere que la cuenta con ese mobileNumber ya exista.
}

tests {
  test("201 Created", function() { expect(res.status).to.equal(201); });
}
