meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{gatewayUrl}}/eazybank/accounts/api/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "{{name}}",
    "email": "{{email}}",
    "mobileNumber": "{{mobileNumber}}"
  }
}

tests {
  test("201 Created", function() {
    expect(res.status).to.equal(201);
  });
}
