        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0hf2ui1_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1212" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1208" y="315" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_05yc652_di" bpmnElement="Task_ManualReview">
        <dc:Bounds x="790" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0c4tksm_di" bpmnElement="Gateway_ManualDecision" isMarkerVisible="true">
